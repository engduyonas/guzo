# Copy to .env for local development. Every setting has a dev default in src/guzo/config.py.
GUZO_ENV=dev
GUZO_MONGO_URL=mongodb://localhost:27017/?directConnection=true
GUZO_MONGO_DB=guzo
GUZO_REDIS_URL=redis://localhost:6379/0
# Required when GUZO_ENV=production (at least 32 characters):
# GUZO_JWT_SECRET=
# GUZO_PUBLIC_BASE_URL=https://api.example.com   (https required in production)
# GUZO_SENTRY_DSN=                                (error reporting is off without it)
# GUZO_MIN_ANDROID_VERSION=0.0.0                  (raise to force old app builds to update)
# GUZO_MIN_IOS_VERSION=0.0.0
